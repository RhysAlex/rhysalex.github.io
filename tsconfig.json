{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "@cloudflare/workers-types"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": true
  },
  "include": [
    "backend/**/*.ts",
    "admin/**/*.ts",
    "admin/**/*.tsx",
    "tests/**/*.ts",
    "shared/**/*.mjs"
  ]
}
